5 bg-white transition duration-300 \"></span></button></div></nav><div id=\"mobile-navigation\" class=\"overflow-hidden border-t border-white/10 bg-brand/95 backdrop-blur-2xl transition-all duration-500 lg:hidden pointer-events-none max-h-0 opacity-0\"><div class=\"mx-auto flex max-w-7xl flex-col px-6 py-7\"><a class=\"border-b border-white/10 py-4 text-sm uppercase tracking-[0.18em] text-white/80 transition hover:text-gold\" href=\"/en/destinations/\">Destinations</a><a class=\"border-b border-white/10 py-4 text-sm uppercase tracking-[0.18em] text-white/80 transition hover:text-gold\" href=\"/en/journeys/first-journey-to-syria/\">The Journey</a><a class=\"border-b border-white/10 py-4 text-sm uppercase tracking-[0.18em] text-white/80 transition hover:text-gold\" href=\"/#catalogue\">Brochure</a><a class=\"border-b border-white/10 py-4 text-sm uppercase tracking-[0.18em] text-white/80 transition hover:text-gold\" href=\"/#about\">About Us</a><a class=\"mt-6 inline-flex min-h-12 items-center justify-center bg-gold px-6 text-xs font-semibold uppercase tracking-[0.2em] text-brand\" href=\"/#request\">Book Now</a></div></div></header><main><header class=\"relative flex min-h-screen items-end overflow-hidden bg-brand pb-16 pt-32 sm:pb-20\"><img alt=\"First Journey to Syria\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/syria/palmyra-columns.webp\"/><div class=\"absolute inset-0 bg-gradient-to-r from-brand via-brand/75 to-brand/20\"></div><div class=\"absolute inset-0 bg-gradient-to-t from-brand via-transparent to-brand/55\"></div><div class=\"relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-10\"><p class=\"text-xs font-semibold uppercase tracking-[0.28em] text-gold\">Signature itinerary</p><h1 class=\"mt-4 max-w-4xl font-serif text-5xl leading-tight text-white sm:text-6xl lg:text-8xl\">First Journey to Syria</h1><p class=\"mt-6 max-w-2xl text-sm leading-8 text-white/75 sm:text-lg\">Seven days of heritage, coastlines, mountains and Syrian hospitality.</p><div class=\"mt-9 flex flex-wrap gap-3\"><span class=\"border border-white/20 bg-brand/55 px-5 py-3 text-xs font-semibold text-white backdrop-blur-md\">7 Days / 6 Nights</span><span class=\"border border-gold bg-gold px-5 py-3 text-xs font-semibold text-brand\">€999 per person</span></div><div class=\"mt-9 flex flex-col gap-3 sm:flex-row\"><a href=\"/brochures/medya-travel-syria-journey-en.pdf\" target=\"_blank\" rel=\"noreferrer\" class=\"inline-flex min-h-13 items-center justify-center bg-gold px-7 text-xs font-semibold uppercase tracking-[0.18em] text-brand transition hover:bg-bronze\">Download English brochure</a><a class=\"inline-flex min-h-13 items-center justify-center border border-white/30 bg-white/5 px-7 text-xs font-semibold uppercase tracking-[0.18em] text-white backdrop-blur-md transition hover:border-gold hover:text-gold\" href=\"#request\">Request this journey</a></div></div></header><section class=\"border-y border-white/10 bg-charcoal py-16 sm:py-20\"><div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-10\"><div class=\"mb-10 text-center\"><p class=\"text-xs font-semibold uppercase tracking-[0.26em] text-gold\">Travel with confidence</p><h2 class=\"mt-3 font-serif text-3xl text-white sm:text-4xl\">Four commitments, clearly stated</h2></div><div class=\"grid gap-px overflow-hidden rounded-sm border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4\"><article class=\"relative min-h-44 bg-brand p-7 sm:p-8\"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">0<!-- -->1</span><h3 class=\"mt-8 text-lg font-semibold leading-7 text-white\">Licensed German Travel Company</h3><div class=\"absolute bottom-0 start-0 h-px w-16 bg-gold\"></div></article><article class=\"relative min-h-44 bg-brand p-7 sm:p-8\"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">0<!-- -->2</span><h3 class=\"mt-8 text-lg font-semibold leading-7 text-white\">Trusted Local Syrian Partner</h3><div class=\"absolute bottom-0 start-0 h-px w-16 bg-gold\"></div></article><article class=\"relative min-h-44 bg-brand p-7 sm:p-8\"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">0<!-- -->3</span><h3 class=\"mt-8 text-lg font-semibold leading-7 text-white\">24/7 Personal Assistance</h3><div class=\"absolute bottom-0 start-0 h-px w-16 bg-gold\"></div></article><article class=\"relative min-h-44 bg-brand p-7 sm:p-8\"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">0<!-- -->4</span><h3 class=\"mt-8 text-lg font-semibold leading-7 text-white\">No Hidden Ground-Service Costs</h3><div class=\"absolute bottom-0 start-0 h-px w-16 bg-gold\"></div></article></div></div></section><section class=\"bg-brand py-20 sm:py-24 lg:py-32\"><div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-10\"><p class=\"text-xs font-semibold uppercase tracking-[0.26em] text-gold\">Day-by-day itinerary</p><div class=\"mt-10 space-y-6\"><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] \"><img alt=\"Arrival in Aleppo\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/syria/aleppo-citadel-night.webp\"/><div class=\"absolute inset-0 bg-gradient-to-t from-brand/55 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 \"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">01</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">Arrival in Aleppo</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">Welcome at Aleppo International Airport and transfer to the Sheraton Aleppo Hotel. After check-in and a short rest, visit the Citadel of Aleppo, enjoy lunch or dinner at Peroya Restaurant, stroll through Khan Al-Shouneh Market and return to the hotel.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] lg:order-2\"><img alt=\"Aleppo to Tartus\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/syria/tartus-coast.webp\"/><div class=\"absolute inset-0 bg-gradient-to-t from-brand/55 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 lg:order-1\"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">02</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">Aleppo to Tartus</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">Breakfast and check-out, followed by the journey to Tartus. Check in at Shahin Resort, relax at the private beach or pool, enjoy lunch at Ark Restaurant and spend the rest of the day using the resort’s leisure facilities.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] \"><img alt=\"Mashta Al Helou\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/syria/sheikh-badr-stream.webp\"/><div class=\"absolute inset-0 bg-gradient-to-t from-brand/55 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 \"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">03</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">Mashta Al Helou</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">Travel to the mountain town of Mashta Al Helou, enjoy its landscapes and religious landmarks, have lunch in the region, visit Dawayat Cave and stop in Al-Kafroun for coffee before returning to Shahin Resort.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] lg:order-2\"><img alt=\"Damascus &amp; Bloudan\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/syria/umayyad-mosque-night.webp\"/><div class=\"absolute inset-0 bg-gradient-to-t from-brand/55 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 lg:order-1\"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">04</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">Damascus &amp; Bloudan</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">Travel to Damascus and check in at Caesar Hotel. Continue to Bloudan, visit Moses Cave and the markets of Madaya, and enjoy lunch at Swiss House Restaurant. In the afternoon, explore Bab Sharqi, Bab Touma, the Umayyad Mosque and Al-Salihiyah, followed by dinner in Bab Touma.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] \"><img alt=\"Maaloula, Saidnaya &amp; Return to Tartus\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/syria/maaloula-panorama.webp\"/><div class=\"absolute inset-0 bg-gradient-to-t from-brand/55 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 \"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">05</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">Maaloula, Saidnaya &amp; Return to Tartus</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">After breakfast and check-out, depart towards Tartus and visit Maaloula and Saidnaya on the way. Continue to Shahin Resort, then to Matn Al Sahel for a fresh seafood lunch at Al Arrab Restaurant, followed by leisure time on the Mediterranean coast.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] lg:order-2\"><img alt=\"Along the Mediterranean Coast to Aleppo\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/syria/wadi-qandil.webp\"/><div class=\"absolute inset-0 bg-gradient-to-t from-brand/55 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 lg:order-1\"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">06</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">Along the Mediterranean Coast to Aleppo</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">Begin the scenic journey to Aleppo via Latakia and Mashqita. Enjoy a boat trip in Mashqita, visit Ras Shamra - ancient Ugarit and the birthplace of one of humanity’s earliest alphabets - have lunch, then continue to Aleppo and check in at the hotel.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] \"><img alt=\"Departure\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/syria/i-love-syria.webp\"/><div class=\"absolute inset-0 bg-gradient-to-t from-brand/55 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 \"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">07</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">Departure</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">Enjoy your final breakfast, check out and transfer to Aleppo International Airport for your departure flight. The journey ends with the memories of Syria’s history, landscapes and hospitality.</p></div></article></div></div></section><section class=\"border-y border-white/10 bg-charcoal py-20 sm:py-24\"><div class=\"mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:px-10\"><article class=\"border border-white/10 bg-brand p-7 sm:p-10\"><h2 class=\"font-serif text-3xl text-white\">Package includes</h2><p class=\"mt-3 text-sm leading-7 text-light-gray\">The price includes all land-package services listed below.</p><ul class=\"mt-7 space-y-4\"><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>7 days / 6 nights accommodation</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Selected hotels and resorts: Sheraton Aleppo, Shahin Resort Tartus and Caesar Hotel Damascus</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Daily breakfast</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Lunches and dinners as specified in the itinerary</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Comfortable air-conditioned transportation throughout the tour</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Airport transfers</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Professional tour guide</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Entrance fees to all attractions included in the itinerary</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Boat trip in Mashqita</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Leisure time at Shahin Resort with beach and pool access</li></ul></article><article class=\"border border-white/10 bg-brand p-7 sm:p-10\"><h2 class=\"font-serif text-3xl text-white\">Not included</h2><ul class=\"mt-7 space-y-4\"><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-1 text-gold\">×</span>International airfare</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-1 text-gold\">×</span>Visa fees</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-1 text-gold\">×</span>Travel insurance</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-1 text-gold\">×</span>Personal expenses</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-1 text-gold\">×</span>Tips and gratuities</li></ul><div class=\"mt-10 border-t border-white/10 pt-8\"><p class=\"text-4xl font-semibold text-gold\">€999 per person</p><p class=\"mt-3 text-sm leading-7 text-light-gray\">The price includes all land-package services listed below.</p></div></article></div></section><section id=\"request\" class=\"relative overflow-hidden bg-brand py-20 sm:py-24 lg:py-32\"><div aria-hidden=\"true\" class=\"absolute -right-36 top-20 h-80 w-80 rounded-full bg-gold/10 blur-[120px]\"></div><div class=\"relative mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-10\"><div><p class=\"text-xs font-semibold uppercase tracking-[0.26em] text-gold\">Journey request</p><h2 class=\"mt-4 max-w-xl font-serif text-4xl leading-tight text-white sm:text-5xl\">Tell us how you would like to travel</h2><p class=\"mt-6 max-w-lg text-sm leading-8 text-light-gray sm:text-base\">Complete the short form and your request will open in WhatsApp, ready to send directly to our travel team.</p></div><form class=\"grid gap-5 border border-white/10 bg-charcoal/80 p-5 shadow-2xl backdrop-blur-sm sm:grid-cols-2 sm:p-8\"><label class=\"text-xs font-medium text-white/70\">Full name<!-- --> *<input class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" autoComplete=\"name\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">Email address<!-- --> *<input type=\"email\" class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" autoComplete=\"email\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">Phone / WhatsApp<!-- --> *<input class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" autoComplete=\"tel\" dir=\"ltr\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">Country of residence<!-- --> *<input class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" autoComplete=\"country-name\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">Number of travellers<!-- --> *<input type=\"number\" min=\"1\" max=\"50\" class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">Preferred travel date<input type=\"date\" class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70 sm:col-span-2\">Your wishes or questions<textarea class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold min-h-32 py-3\"></textarea></label><div class=\"sm:col-span-2\"><button type=\"submit\" class=\"min-h-13 w-full bg-gold px-7 text-xs font-semibold uppercase tracking-[0.18em] text-brand transition hover:bg-bronze sm:w-auto\">Send Journey Request</button><p class=\"mt-4 max-w-2xl text-[11px] leading-5 text-white/40\">Your details are not stored on this website. They are transferred to WhatsApp only when you submit.</p></div></form></div></section></main><footer id=\"book\" class=\"relative overflow-hidden border-t border-white/10 bg-brand py-14 sm:py-20\"><div aria-hidden=\"true\" class=\"absolute right-0 top-0 h-80 w-80 rounded-full bg-gold/5 blur-3xl\"></div><div class=\"relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10\"><div class=\"grid gap-12 border-b border-white/10 pb-12 lg:grid-cols-[1.2fr_0.7fr_1.1fr]\"><div><a class=\"inline-flex items-center gap-4\" aria-label=\"MEDYA TRAVEL – Home\" href=\"/\"><span class=\"relative h-20 w-20 overflow-hidden rounded-full border border-gold/60 shadow-[0_0_30px_rgba(199,156,89,0.2)]\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://res.cloudinary.com/lclxcm8g/image/upload/v1783941973/Gemini_Generated_Image_27jxkk27jxkk27jx_m7v3kj.png\"/></span><span><span class=\"block font-serif text-2xl tracking-[0.12em] text-white\">MEDYA TRAVEL</span><s