{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/en/layout,_N_T_/en/journeys/layout,_N_T_/en/journeys/first-journey-to-syria/layout,_N_T_/en/journeys/first-journey-to-syria/page,_N_T_/en/journeys/first-journey-to-syria"},"segmentPaths":["/_tree","/_full","/en/journeys/first-journey-to-syria/__PAGE__","/en/journeys/first-journey-to-syria","/en/journeys","/en","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\" dir=\"ltr\" class=\"cormorant_garamond_ec0b03bc-module__6ZvGZG__variable inter_fe8b9d92-module__LINzvG__variable noto_kufi_arabic_6a3beec8-module__SxMZNq__variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/01e4147cff8141ee-s.p.3huc2loe0ie8a.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/744885950b1fe0ff-s.p.30d2r2x65bwdm.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"https://res.cloudinary.com/lclxcm8g/image/upload/v1783941973/Gemini_Generated_Image_27jxkk27jxkk27jx_m7v3kj.png\"/><link rel=\"preload\" as=\"image\" href=\"/syria/palmyra-columns.webp\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/3e1-y29w2vb1g.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/0dhbjz-xsmu83.js\"/><script src=\"/_next/static/chunks/15orcrkp-_9ct.js\" async=\"\"></script><script src=\"/_next/static/chunks/1upe53-127sm4.js\" async=\"\"></script><script src=\"/_next/static/chunks/1k_jf9ueczw-u.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3yum2qn1inasq.js\" async=\"\"></script><script src=\"/_next/static/chunks/05-c3ty_6