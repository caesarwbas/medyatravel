{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/de/layout,_N_T_/de/reisen/layout,_N_T_/de/reisen/erste-syrienreise/layout,_N_T_/de/reisen/erste-syrienreise/page,_N_T_/de/reisen/erste-syrienreise"},"segmentPaths":["/_tree","/_full","/de/reisen/erste-syrienreise/__PAGE__","/de/reisen/erste-syrienreise","/de/reisen","/de","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\" dir=\"ltr\" class=\"cormorant_garamond_ec0b03bc-module__6ZvGZG__variable inter_fe8b9d92-module__LINzvG__variable noto_kufi_arabic_6a3beec8-module__SxMZNq__variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/01e4147cff8141ee-s.p.3huc2loe0ie8a.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/744885950b1fe0ff-s.p.30d2r2x65bwdm.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"https://res.cloudinary.com/lclxcm8g/image/upload/v1783941973/Gemini_Generated_Image_27jxkk27jxkk27jx_m7v3kj.png\"/><link rel=\"preload\" as=\"image\" href=\"/syria/palmyra-columns.webp\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/3y2rtw-fm6vnz.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/0dhbjz-xsmu83.js\"/><script src=\"/_next/static/chunks/15orcrkp-_9ct.js\" async=\"\"></script><script src=\"/_next/static/chunks/1upe53-127sm4.js\" async=\"\"></script><script src=\"/_next/static/chunks/1k_jf9ueczw-u.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3yum2qn1inasq.js\" async=\"\"></script><script src=\"/_next/static/chunks/05-c3ty_6dwfk.js\" async=\"\"></script><script src=\"/_next/static/chunks/14mrh2-p_w84d.js\" async=\"\"></script><script src=\"/_next/static/chunks/0ogt2yxhgmqrp.js\" async=\"\"></script><script src=\"/_next/static/chunks/2zxk81ro18i2t.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Erste Syrienreise - 7 Tage / 6 Übernachtungen</title><meta name=\"description\" content=\"Eine siebentägige Syrienreise durch Aleppo, Tartus, Mashta Al Helou, Damaskus, Maaloula und entlang der Mittelmeerküste.\"/><meta name=\"application-name\" content=\"MEDYA TRAVEL\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta name=\"category\" content=\"travel\"/><link rel=\"canonical\" href=\"https://medyatravel.de/de/reisen/erste-syrienreise/\"/><link rel=\"alternate\" hrefLang=\"en\" href=\"https://medyatravel.de/en/journeys/first-journey-to-syria/\"/><link rel=\"alternate\" hrefLang=\"de\" href=\"https://medyatravel.de/de/reisen/erste-syrienreise/\"/><link rel=\"alternate\" hrefLang=\"ar\" href=\"https://medyatravel.de/ar/journeys/first-journey-to-syria/\"/><meta property=\"og:title\" content=\"Syrien Reisen &amp; Rundreisen | MEDYA TRAVEL Deutschland\"/><meta property=\"og:description\" content=\"Individuelle Rundreisen und Kulturreisen nach Syrien ab Deutschland.\"/><meta property=\"og:url\" content=\"https://medyatravel.de/de/\"/><meta property=\"og:site_name\" content=\"MEDYA TRAVEL\"/><meta property=\"og:locale\" content=\"de_DE\"/><meta property=\"og:image\" content=\"https://medyatravel.de/opengraph-image.jpg\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"MEDYA TRAVEL – Reisen nach Syrien\"/><meta property=\"og:locale:alternate\" content=\"en_GB\"/><meta property=\"og:locale:alternate\" content=\"ar_AR\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Syrien Reisen &amp; Rundreisen | MEDYA TRAVEL\"/><meta name=\"twitter:description\" content=\"Individuelle Rundreisen und Kulturreisen nach Syrien ab Deutschland.\"/><meta name=\"twitter:image\" content=\"https://medyatravel.de/twitter-image.jpg\"/><link rel=\"shortcut icon\" href=\"/icon.png\"/><link rel=\"icon\" href=\"/icon.png\" type=\"image/png\" sizes=\"512x512\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png\" type=\"image/png\" sizes=\"180x180\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full overflow-x-hidden bg-brand font-sans text-white\"><div hidden=\"\"><!--$--><!--/$--></div><div lang=\"de\" dir=\"ltr\" class=\"site-de\"><header class=\"fixed inset-x-0 top-0 z-50 transition-all duration-500 bg-gradient-to-b from-brand/80 to-transparent\"><nav aria-label=\"Hauptnavigation\" class=\"mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-10\"><a class=\"group flex items-center gap-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold\" aria-label=\"MEDYA TRAVEL – Startseite\" href=\"/de/\"><span class=\"relative h-12 w-12 shrink-0 overflow-hidden rounded-full border border-gold/60 bg-brand shadow-[0_0_24px_rgba(199,156,89,0.18)] transition duration-300 group-hover:border-gold group-hover:shadow-[0_0_30px_rgba(199,156,89,0.35)]\"><img alt=\"MEDYA TRAVEL\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://res.cloudinary.com/lclxcm8g/image/upload/v1783941973/Gemini_Generated_Image_27jxkk27jxkk27jx_m7v3kj.png\"/></span><span class=\"hidden sm:block\"><span class=\"block font-serif text-lg tracking-[0.12em] text-white\">MEDYA TRAVEL</span><span class=\"block text-[8px] upperc