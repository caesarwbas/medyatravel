ght-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 ring-1 ring-inset ring-white/5\"></div></div></figure><figure class=\"group relative mb-5 break-inside-avoid overflow-hidden border border-white/10 bg-charcoal\"><div class=\"relative min-h-[260px] sm:min-h-[320px]\"><img alt=\"إسبانيا الأساسية 13\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://res.cloudinary.com/lclxcm8g/image/upload/v1785234888/58_ri3rfy.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 ring-1 ring-inset ring-white/5\"></div></div></figure></div></div></section><section class=\"bg-brand py-20 sm:py-24 lg:py-32\"><div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-10\"><p class=\"text-xs font-semibold uppercase tracking-[0.26em] text-gold\">البرنامج يومًا بيوم</p><div class=\"mt-10 space-y-6\"><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] \"><img alt=\"برشلونة ← سرقسطة ← مدريد\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://iberica-travel.com/files/travel%20packages%202018/3.%20Andalusia%20and%20Levante/LasRamblasBarcelonaTitle.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 bg-gradient-to-t from-brand/45 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 \"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">01</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">برشلونة ← سرقسطة ← مدريد</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">الانطلاق صباحًا من برشلونة نحو سرقسطة، وزيارة بازيليك سيدة العمود والاستمتاع بإطلالات نهر إيبرو، ثم متابعة الطريق إلى مدريد لتناول العشاء والمبيت.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] lg:order-2\"><img alt=\"مدريد ← قرطبة ← إشبيلية\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://iberica-travel.com/files/travel%20packages%202018/3.%20Andalusia%20and%20Levante/Cordoba%20courtyardin.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 bg-gradient-to-t from-brand/45 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 lg:order-1\"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">02</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">مدريد ← قرطبة ← إشبيلية</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">عبور سهول قشتالة لا مانتشا والوصول إلى قرطبة لجولة في المركز التاريخي والحي اليهودي والجامع-الكاتدرائية الاستثنائي، ثم متابعة الرحلة إلى إشبيلية بعد الظهر.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] \"><img alt=\"إشبيلية\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://iberica-travel.com/files/travel%20packages%202018/3.%20Andalusia%20and%20Levante/GoldTowerSeville.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 bg-gradient-to-t from-brand/45 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 \"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">03</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">إشبيلية</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">اكتشاف ساحة إسبانيا وحديقة ماريا لويزا وكاتدرائية إشبيلية وحي سانتا كروز التاريخي، مع وقت حر بعد الظهر لزيارة الخيرالدا أو تريانا أو حضور عرض فلامنكو اختياري.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] lg:order-2\"><img alt=\"إشبيلية ← غرناطة\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://iberica-travel.com/files/travel%20packages%202018/3.%20Andalusia%20and%20Levante/AlbaicinGranadaTitle.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 bg-gradient-to-t from-brand/45 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 lg:order-1\"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">04</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">إشبيلية ← غرناطة</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">التوجه شرقًا إلى غرناطة وزيارة مجمع الحمراء بما فيه قصور بني نصر وحدائق جنة العريف والقصبة، ثم وقت حر لاكتشاف حي البيازين والأسواق وثقافة التاباس.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] \"><img alt=\"غرناطة ← فالنسيا\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://iberica-travel.com/files/travel%20packages%202018/3.%20Andalusia%20and%20Levante/CityofArtsandSciencesValenciaTitle.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 bg-gradient-to-t from-brand/45 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 \"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">05</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">غرناطة ← فالنسيا</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">رحلة عبر مناظر متنوعة نحو فالنسيا، مع فرصة لاكتشاف مدينة الفنون والعلوم والبلدة القديمة وبورصة الحرير والبوابات التاريخية، والاستمتاع بمدينة تُعد مهد طبق الباييّا.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] lg:order-2\"><img alt=\"فالنسيا ← برشلونة\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://iberica-travel.com/files/travel%20packages%202018/3.%20Andalusia%20and%20Levante/valenciacity.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 bg-gradient-to-t from-brand/45 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 lg:order-1\"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">06</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">فالنسيا ← برشلونة</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">صباح أخير هادئ في فالنسيا لزيارة الشواطئ أو السوق المركزي أو حي إل كارمن أو الكاتدرائية، ثم العودة إلى برشلونة بعد الظهر واختتام الرحلة.</p></div></article></div></div></section><section class=\"border-y border-white/10 bg-charcoal py-20 sm:py-24\"><div class=\"mx-auto max-w-4xl px-4 sm:px-6 lg:px-10\"><article class=\"border border-white/10 bg-brand p-7 sm:p-10\"><h2 class=\"font-serif text-3xl text-white\">تشمل الباقة</h2><ul class=\"mt-7 grid gap-4 sm:grid-cols-2\"><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>الإقامة في فنادق مختارة من فئة أربع نجوم</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>خمس وجبات إفطار وثلاث وجبات عشاء</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>حافلة حديثة ومكيّفة</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>مرافق سياحي متعدد اللغات</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>جولات مع مرشدين محليين في قرطبة وإشبيلية وغرناطة</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>تذكرة دخول الجامع-الكاتدرائية في قرطبة</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>تذكرة دخول قصر الحمراء في غرناطة</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>تأمين سفر وخدمة واي فاي على متن الحافلة</li></ul></article></div></section><section id=\"request\" class=\"relative overflow-hidden bg-brand py-20 sm:py-24 lg:py-32\"><div aria-hidden=\"true\" class=\"absolute -right-36 top-20 h-80 w-80 rounded-full bg-gold/10 blur-[120px]\"></div><div class=\"relative mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-10\"><div><p class=\"text-xs font-semibold uppercase tracking-[0.26em] text-gold\">طلب رحلة</p><h2 class=\"mt-4 max-w-xl font-serif text-4xl leading-tight text-white sm:text-5xl\">أخبرنا كيف ترغب أن تكون رحلتك</h2><p class=\"mt-6 max-w-lg text-sm leading-8 text-light-gray sm:text-base\">املأ النموذج المختصر، وسيُفتح طلبك في واتساب جاهزًا لإرساله مباشرة إلى فريق الرحلات لدينا.</p></div><form class=\"grid gap-5 border border-white/10 bg-charcoal/80 p-5 shadow-2xl backdrop-blur-sm sm:grid-cols-2 sm:p-8\"><label class=\"text-xs font-medium text-white/70\">الاسم الكامل<!-- --> *<input class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" autoComplete=\"name\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">البريد الإلكتروني<!-- --> *<input type=\"email\" class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" autoComplete=\"email\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">رقم الهاتف / واتساب<!-- --> *<input class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" autoComplete=\"tel\" dir=\"ltr\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">بلد الإقامة<!-- --> *<input class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" autoComplete=\"country-name\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">عدد المسافرين<!-- --> *<input type=\"number\" min=\"1\" max=\"50\" class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">التاريخ المفضل للسفر<input type=\"date\" class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70 sm:col-span-2\">رغباتك أو استفساراتك<textarea class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold min-h-32 py-3\"></textarea></label><div class=\"sm:col-span-2\"><button type=\"submit\" class=\"min-h-13 w-full bg-gold px-7 text-xs font-semibold uppercase tracking-[0.18em] text-brand transition hover:bg-bronze sm:w-auto\">إرسال طلب الرحلة</button><p class=\"mt-4 max-w-2xl text-[11px] leading-5 text-white/40\">لا تُخزّن بياناتك في الموقع، بل تُنقل إلى واتساب فقط عند إرسال الطلب.</p></div></form></div></section></main><footer id=\"book\" class=\"relative overflow-hidden border-t border-white/10 bg-brand py-14 sm:py-20\"><div aria-hidden=\"true\" class=\"absolute right-0 top-0 h-80 w-80 rounded-full bg-gold/5 blur-3xl\"></div><div class=\"relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10\"><div class=\"grid gap-12 border-b border-white/10 pb-12 lg:grid-cols-[1.2fr_0.7fr_1.1fr]\"><div><a class=\"inline-flex items-center gap-4\" aria-label=\"MEDYA TRAVEL – الصفحة الرئيسية\" href=\"/ar/\"><span class=\"relative h-20 w-20 overflow-hidden rounded-full border border-gold/60 shadow-[0_0_30px_rgba(199,156,89,0.2)]\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://res.cloudinary.com/lclxcm8g/image/upload/v1783941973/Gemini_Generated_Image_27jxkk27jxkk27jx_m7v3kj.png\"/></span><span><span class=\"block font-serif text-2xl tracking-[0.12em] text-white\">MEDYA TRAVEL</span><span class=\"block text-[9px] uppercase tracking-[0.32em] text-gold\">سافر كما يليق بك</span></span></a><p class=\"mt-6 max-w-md text-sm leading-7 text-light-gray\">رحلات خاصة ومنتقاة بعناية عبر سوريا، تصل المسافرين من ألمانيا بتاريخ البلاد وثقافتها وكرم ضيافتها وتجاربها الإنسانية الاستثنائية.</p><a class=\"mt-7 inline-flex min-h-12 items-center justify-center border border-gold bg-gold px-6 text-[10px] font-semibold uppercase tracking-[0.2em] text-brand transition hover:bg-transparent hover:text-gold\" href=\"/ar/#request\">احجز رحلتك الآن</a></div><div><h2 class=\"text-xs font-semibold uppercase tracking-[0.26em] text-gold\">التنقل</h2><nav class=\"mt-6 flex flex-col gap-4\" aria-label=\"التنقل في تذييل الموقع\"><a class=\"w-fit text-sm text-white/65 transition hover:text-gold\" href=\"/ar/destinations/\">الوجهات</a><a class=\"w-fit text-sm text-white/65 transition hover:text-gold\" href=\"/ar/journeys/first-journey-to-syria/\">الرحلة</a><a class=\"w-fit text-sm text-white/65 transition hover:text-gold\" href=\"/ar/#catalogue\">البروشور</a><a class=\"w-fit text-sm text-white/65 transition hover:text-gold\" href=\"/ar/#about\">من نحن</a></nav></div><div><h2 class=\"text-xs font-semibold uppercase tracking-[0.26em] text-gold\">تواصل معنا</h2><div class=\"mt-6 space-y-5\"><a hre