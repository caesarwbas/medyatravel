m8g/image/upload/v1785234888/036-Basilica-of-Our-Lady-of-the-Pillar-and-Ebor-River-in-the-Evening-Zaragoza-Aragon-Spain_gbyi3d.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 ring-1 ring-inset ring-white/5\"></div></div></figure><figure class=\"group relative mb-5 break-inside-avoid overflow-hidden border border-white/10 bg-charcoal\"><div class=\"relative min-h-[260px] sm:min-h-[320px]\"><img alt=\"Essentielles Spanien 11\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://res.cloudinary.com/lclxcm8g/image/upload/v1785234888/2-weeks-traveling-spain-madrid-cordoba-seville-granada-and-v0-v98wsac6va7a1_kmiuhj.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 ring-1 ring-inset ring-white/5\"></div></div></figure><figure class=\"group relative mb-5 break-inside-avoid overflow-hidden border border-white/10 bg-charcoal\"><div class=\"relative min-h-[260px] sm:min-h-[320px]\"><img alt=\"Essentielles Spanien 12\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://res.cloudinary.com/lclxcm8g/image/upload/v1785234888/a85927d6f7b866ee638f7d419c3fe294-1643363128_xekca5.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 ring-1 ring-inset ring-white/5\"></div></div></figure><figure class=\"group relative mb-5 break-inside-avoid overflow-hidden border border-white/10 bg-charcoal\"><div class=\"relative min-h-[260px] sm:min-h-[320px]\"><img alt=\"Essentielles Spanien 13\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://res.cloudinary.com/lclxcm8g/image/upload/v1785234888/58_ri3rfy.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 ring-1 ring-inset ring-white/5\"></div></div></figure></div></div></section><section class=\"bg-brand py-20 sm:py-24 lg:py-32\"><div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-10\"><p class=\"text-xs font-semibold uppercase tracking-[0.26em] text-gold\">Reiseverlauf Tag für Tag</p><div class=\"mt-10 space-y-6\"><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] \"><img alt=\"Barcelona → Zaragoza → Madrid\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://iberica-travel.com/files/travel%20packages%202018/3.%20Andalusia%20and%20Levante/LasRamblasBarcelonaTitle.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 bg-gradient-to-t from-brand/45 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 \"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">01</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">Barcelona → Zaragoza → Madrid</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">Morgendliche Abfahrt von Barcelona nach Zaragoza. Besuchen Sie die Basilika Nuestra Señora del Pilar und genießen Sie den Blick über den Ebro, bevor es weiter nach Madrid zum Abendessen und zur Übernachtung geht.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] lg:order-2\"><img alt=\"Madrid → Córdoba → Sevilla\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://iberica-travel.com/files/travel%20packages%202018/3.%20Andalusia%20and%20Levante/Cordoba%20courtyardin.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 bg-gradient-to-t from-brand/45 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 lg:order-1\"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">02</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">Madrid → Córdoba → Sevilla</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">Durchqueren Sie die Ebenen von Castilla-La Mancha und erreichen Sie Córdoba zu einer Führung durch Altstadt, jüdisches Viertel und die außergewöhnliche Mezquita-Kathedrale. Am Nachmittag Weiterfahrt nach Sevilla.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] \"><img alt=\"Sevilla\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://iberica-travel.com/files/travel%20packages%202018/3.%20Andalusia%20and%20Levante/GoldTowerSeville.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 bg-gradient-to-t from-brand/45 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 \"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">03</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">Sevilla</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">Entdecken Sie Plaza de España, den María-Luisa-Park, die Kathedrale von Sevilla und das historische Viertel Santa Cruz. Der Nachmittag steht für Giralda, Metropol Parasol, Triana oder Flamenco zur freien Verfügung.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] lg:order-2\"><img alt=\"Sevilla → Granada\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://iberica-travel.com/files/travel%20packages%202018/3.%20Andalusia%20and%20Levante/AlbaicinGranadaTitle.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 bg-gradient-to-t from-brand/45 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 lg:order-1\"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">04</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">Sevilla → Granada</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">Fahrt nach Granada und Besuch der Alhambra mit Nasridenpalästen, Generalife-Gärten und Alcazaba. Danach Freizeit für Albaicín, Märkte und Tapas-Kultur.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] \"><img alt=\"Granada → Valencia\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://iberica-travel.com/files/travel%20packages%202018/3.%20Andalusia%20and%20Levante/CityofArtsandSciencesValenciaTitle.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 bg-gradient-to-t from-brand/45 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 \"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">05</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">Granada → Valencia</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">Fahrt durch abwechslungsreiche Landschaften nach Valencia. Entdecken Sie die Stadt der Künste und Wissenschaften, Altstadt, Seidenbörse und mittelalterliche Tore sowie die Heimat der Paella.</p></div></article><article class=\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\"><div class=\"relative min-h-72 lg:min-h-[420px] lg:order-2\"><img alt=\"Valencia → Barcelona\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://iberica-travel.com/files/travel%20packages%202018/3.%20Andalusia%20and%20Levante/valenciacity.jpg\"/><div class=\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\"/></div><div class=\"absolute inset-0 bg-gradient-to-t from-brand/45 via-transparent to-transparent\"></div></div><div class=\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 lg:order-1\"><span class=\"text-xs font-semibold tracking-[0.24em] text-gold\">06</span><h2 class=\"mt-4 font-serif text-3xl text-white sm:text-4xl\">Valencia → Barcelona</h2><p class=\"mt-5 text-sm leading-8 text-light-gray sm:text-base\">Genießen Sie den letzten Vormittag in Valencia an den Stränden, auf dem Zentralmarkt, in El Carmen oder an der Kathedrale. Am Nachmittag Rückfahrt nach Barcelona.</p></div></article></div></div></section><section class=\"border-y border-white/10 bg-charcoal py-20 sm:py-24\"><div class=\"mx-auto max-w-4xl px-4 sm:px-6 lg:px-10\"><article class=\"border border-white/10 bg-brand p-7 sm:p-10\"><h2 class=\"font-serif text-3xl text-white\">Im Paket enthalten</h2><ul class=\"mt-7 grid gap-4 sm:grid-cols-2\"><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Unterkunft in ausgewählten Vier-Sterne-Hotels</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Fünf Frühstücke und drei Abendessen</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Moderner klimatisierter Reisebus</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Mehrsprachige Reisebegleitung</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Lokale Führungen in Córdoba, Sevilla und Granada</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Eintritt in die Mezquita-Kathedrale von Córdoba</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Eintritt in die Alhambra in Granada</li><li class=\"flex gap-3 text-sm leading-6 text-white/75\"><span class=\"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold\"></span>Reiseversicherung und WLAN an Bord</li></ul></article></div></section><section id=\"request\" class=\"relative overflow-hidden bg-brand py-20 sm:py-24 lg:py-32\"><div aria-hidden=\"true\" class=\"absolute -right-36 top-20 h-80 w-80 rounded-full bg-gold/10 blur-[120px]\"></div><div class=\"relative mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-10\"><div><p class=\"text-xs font-semibold uppercase tracking-[0.26em] text-gold\">Reiseanfrage</p><h2 class=\"mt-4 max-w-xl font-serif text-4xl leading-tight text-white sm:text-5xl\">Erzählen Sie uns, wie Sie reisen möchten</h2><p class=\"mt-6 max-w-lg text-sm leading-8 text-light-gray sm:text-base\">Füllen Sie das kurze Formular aus. Ihre Anfrage wird anschließend in WhatsApp geöffnet und kann direkt an unser Reiseteam gesendet werden.</p></div><form class=\"grid gap-5 border border-white/10 bg-charcoal/80 p-5 shadow-2xl backdrop-blur-sm sm:grid-cols-2 sm:p-8\"><label class=\"text-xs font-medium text-white/70\">Vor- und Nachname<!-- --> *<input class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" autoComplete=\"name\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">E-Mail-Adresse<!-- --> *<input type=\"email\" class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" autoComplete=\"email\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">Telefon / WhatsApp<!-- --> *<input class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" autoComplete=\"tel\" dir=\"ltr\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">Wohnsitzland<!-- --> *<input class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" autoComplete=\"country-name\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">Anzahl der Reisenden<!-- --> *<input type=\"number\" min=\"1\" max=\"50\" class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70\">Gewünschter Reisezeitraum<input type=\"date\" class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold\" value=\"\"/></label><label class=\"text-xs font-medium text-white/70 sm:col-span-2\">Wünsche oder Fragen<textarea class=\"mt-2 min-h-12 w-full border border-white/15 bg-brand/60 px-4 text-sm text-white outline-none transition placeholder:text-white/25 focus:border-gold min-h-32 py-3\"></textarea></label><div class=\"sm:col-span-2\"><button type=\"submit\" class=\"min-h-13 w-full bg-gold px-7 text-xs font-semibold uppercase tracking-[0.18em] text-brand transition hover:bg-bronze sm:w-auto\">Reiseanfrage senden</button><p class=\"mt-4 max-w-2xl text-[11px] leading-5 text-white/40\">Ihre Angaben werden auf dieser Website nicht gespeichert. Sie werden erst beim Absenden an WhatsApp übergeben.</p></div></form></div></section></main><footer id=\"book\" class=\"relative overflow-hidden border-t border-white/10 bg-brand py-14 sm:py-20\"><div aria-hidden=\"true\" class=\"absolute right-0 top-0 h-80 w-80 rounded-full bg-gold/5 blur-3xl\"></div><div class=\"relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-10\"><div class=\"grid gap-12 border-b border-white/10 pb-12 lg:grid-cols-[1.2fr_0.7fr_1.1fr]\"><div><a class=\"inline-flex items-center gap-4\" aria-label=\"MEDYA TRAVEL – Startseite\" href=\"/de/\"><span class=\"relative h-20 w-20 overflow-hidden rounded-full border border-gold/60 shadow-[0_0_30px_rgba(199,156,89,0.2)]\"><img alt=\"MEDYA TRAVEL\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://res.cloudinary.com/lclxcm8g/image/upload/v1783941973/Gemini_Generated_Image_27jxkk27jxkk27jx_m7v3kj.png\"/></span><span><span class=\"block font-serif text-2xl tracking-[0.12em] text-white\">MEDYA TRAVEL</span><span class=\"block text-[9px] uppercase tracking-[0.32em] text-gold\">Reisen wie es sein sollte</span></span></a><p class=\"mt-6 max-w-md text-sm leading-7 text-light-gray\">Exklusiv geplante Privatreisen durch Syrien, die Reisende aus Deutschland mit Geschichte, Kultur, Gastfreundschaft und außergewöhnlichen Begegnungen verbinden.</p><a class=\"mt-7 inline-flex min-h-12 items-center justify-center border border-gold bg-gold px-6 text-[10px] font-semibold uppercase tracking-[0.2em] text-brand transition hover:bg-transparent hover:text-gold\" href=\"/de/#request\">Reise jetzt buchen</a><