ight-gray sm:text-base\",\"children\":\"Fahrt nach Granada und Besuch der Alhambra mit Nasridenpalästen, Generalife-Gärten und Alcazaba. Danach Freizeit für Albaicín, Märkte und Tapas-Kultur.\"}]]}]]}]\n2a:[\"$\",\"article\",\"5\",{\"className\":\"grid overflow-hidden border border-white/10 bg-charcoal lg:grid-cols-[0.8fr_1.2fr]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative min-h-72 lg:min-h-[420px] \",\"children\":[[[\"$\",\"$L6\",null,{\"src\":\"https://iberica-travel.com/files/travel%20packages%202018/3.%20Andalusia%20and%20Levante/CityofArtsandSciencesValenciaTitle.jpg\",\"alt\":\"Granada → Valencia\",\"fill\":true,\"priority\":false,\"unoptimized\":true,\"sizes\":\"(max-width: 1024px) 100vw, 50vw\",\"className\":\"object-cover\"}],[\"$\",\"div\",null,{\"className\":\"pointer-events-none absolute right-4 top-4 h-16 w-32 sm:right-6 sm:top-6 sm:h-20 sm:w-40\",\"children\":[\"$\",\"$L6\",null,{\"src\":\"https://drive.google.com/file/d/1nlA5g82W2baOf4FvFmvwOxuR6PI9ZRi1/view?usp=sharing\",\"alt\":\"MEDYA TRAVEL\",\"fill\":true,\"unoptimized\":true,\"sizes\":\"160px\",\"className\":\"object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.7)]\"}]}]],[\"$\",\"div\",null,{\"className\":\"absolute inset-0 bg-gradient-to-t from-brand/45 via-transparent to-transparent\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col justify-center p-7 sm:p-10 lg:p-14 \",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-semibold tracking-[0.24em] text-gold\",\"children\":\"05\"}],[\"$\",\"h2\",null,{\"className\":\"mt-4 font-serif text-3xl text-white sm:text-4xl\",\"children\":\"Granada → Valencia\"}],[\"$\",\"p\",null,{\"className\":\"mt-5 text-sm leading-8 text-light-gray sm:text-base\",\"children\":\"Fahrt durch abwechslungsreiche Landschaften nach Valencia. Entdecken Sie die Stadt der Künste und Wissenschaften, Altstadt, Seidenbörse und mittelalterliche Tore sowie die Heimat der Paella.\"}]]}]]}]\n2b:[\"$\",\"article\",\"6\",{\"className\":\"grid overf