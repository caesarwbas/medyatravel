f text-5xl text-white sm:text-6xl\",\"children\":\"General Terms and Conditions\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm text-white/40\",\"children\":\"Draft status: July 2026\"}],[\"$\",\"div\",null,{\"className\":\"mt-10 border-s-4 border-gold bg-gold/10 p-5 text-sm leading-7 text-white/80\",\"children\":\"This draft is not a substitute for travel-law advice. It must be completed and approved by a German lawyer before it is used for bookings.\"}],[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"section\",\"1. Scope and contracting party\",{\"className\":\"border-t border-white/10 pt-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-serif text-3xl text-white\",\"children\":\"1. Scope and contracting party\"}],[\"$\",\"div\",null,{\"className\":\"mt-5 space-y-4\",\"children\":[[\"$\",\"p\",\"These terms are intended for travel services offered by MEDYA TRAVEL. Add the full legal identity and clarify whether MEDYA TRAVEL acts as tour operator, travel agent or provider of linked travel arrangements for each offer.\",{\"className\":\"text-sm leading-8 text-light-gray sm:text-base\",\"children\":\"These terms are intended for travel services offered by MEDYA TRAVEL. Add the full legal identity and clarify whether MEDYA TRAVEL acts as tour operator, travel agent or provider of linked travel arrangements for each offer.\"}]]}]]}],\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\"]}]]}]}],\"$Ld\",\"$Le\"]}],[\"$Lf\"],\"$L10\"]}],{},null,false,null]},null,false,\"$@11\"]},null,false,\"$@11\"]},null,false,\"$@11\"]},null,false,null],\"$L12\",false]],\"m\":\"$undefined\",\"G\":[\"$13\",[\"$L14\"]],\"S\":true,\"h\":null,\"s\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"Gn8anLgfWa_hZB6svNdV-\"}\n15:I[22016,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/2w3d5ka4-7q9_.js\"],\"\"]\n16:I[85437,[\"/_next/static/chunks/05-c3ty_6